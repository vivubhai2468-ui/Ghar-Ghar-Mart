# Client build-time API URL (HTTPS origin, no /api/trpc suffix)
EXPO_PUBLIC_API_BASE_URL=https://your-api.example.com

# Server runtime — set real values only in your hosting provider's secret manager
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_SERVER_URL=https://your-auth-provider.example.com
OWNER_OPEN_ID=replace-with-owner-id
VITE_APP_ID=replace-with-app-id
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Configure any OTP/SMS, push notification, payment, and object-storage credentials
# required by the features you intend to enable. Never commit real secrets.

# Customer password reset email (Resend)
RESEND_API_KEY=
PASSWORD_RESET_EMAIL_FROM=Ghar Ghar Mart <no-reply@your-verified-domain.example>
PUBLIC_APP_URL=https://your-app.example.com
